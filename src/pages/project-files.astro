---
import Layout from '../layouts/Layout.astro';
import { PAYHIP_URL, YOUTUBE_URL } from '../data/socials';
import { projectFiles } from '../data/project-files';

// Decorative arrangement view: each clip is [start %, length %] on a 0–100 timeline.
const sections = [
  { name: 'Intro', width: 18 },
  { name: 'Build', width: 18 },
  { name: 'Drop', width: 24 },
  { name: 'Break', width: 16 },
  { name: 'Drop', width: 24 },
];
const lanes = [
  { name: 'Drums', clips: [[0, 36], [36, 24], [76, 24]], accent: false },
  { name: 'Bass', clips: [[18, 18], [36, 24], [76, 24]], accent: false },
  { name: 'Chords', clips: [[0, 18], [36, 24], [60, 40]], accent: false },
  { name: 'Lead', clips: [[36, 24], [76, 24]], accent: true },
  { name: 'Vocals', clips: [[8, 22], [60, 16]], accent: false },
  { name: 'FX', clips: [[30, 6], [56, 4], [70, 6]], accent: false },
];

const inside = [
  {
    title: 'Complete FL Studio project',
    text: 'The full FLP with every channel, pattern, playlist clip and mixer insert, exactly as it was finished.',
  },
  {
    title: 'Samples',
    text: 'All samples used in the project are in the ZIP, so you see the sound selection behind every part of the track.',
  },
  {
    title: 'Presets',
    text: 'The synth presets behind the leads, chords and basses, so you can load and study the exact sounds.',
  },
  {
    title: 'Mixing & Mastering',
    text: 'The full mixer setup with EQ, compression, sidechain and effects, plus the mastering chain on the master channel.',
  },
];

const kinds = [
  {
    label: 'Drop Remake',
    title: 'Drop Remakes',
    text: 'The drops of well-known progressive house and big room tracks, rebuilt from scratch in FL Studio as close to the original as possible. All drop remakes are free.',
    covers: ['Sound selection', 'Mixing', 'Mastering'],
  },
  {
    label: 'Original',
    title: 'Original FLPs',
    text: 'The complete FL Studio projects of my own tracks and remixes, so you also see the full arrangement and, for my original tracks, the songwriting.',
    covers: ['Arrangement', 'Songwriting', 'Sound selection', 'Mixing', 'Mastering'],
  },
];

const steps = [
  {
    title: 'Listen',
    text: 'Hear the drop remakes on my YouTube channel and pick the project you want to learn from.',
  },
  {
    title: 'Download',
    text: 'Get the project file in my Payhip store. You receive a ZIP with the FLP, samples and presets.',
  },
  {
    title: 'Learn',
    text: 'Open the FLP in FL Studio, solo the channels and use what you learn in your own productions.',
  },
];

const faqs = [
  {
    q: 'What is included in a project file?',
    a: 'Every download is a ZIP with the complete FL Studio project (FLP), all samples and the presets used. You see the sound selection, mixing and mastering exactly as in the finished version. The original FLPs of my own tracks also show the full arrangement and songwriting.',
  },
  {
    q: 'Are the project files free?',
    a: 'All drop remakes and some of my original FLPs are free to download. The other original FLPs cost €3.99 each. The price is listed next to every project file on this page.',
  },
  {
    q: 'Which DAW do I need?',
    a: 'The projects are made in FL Studio, so you need FL Studio to open the FLP files.',
  },
  {
    q: 'What is the difference between a drop remake and an original FLP?',
    a: 'A drop remake is the drop of a well-known progressive house or big room track that I rebuilt from scratch in FL Studio, as close to the original as possible. An original FLP is the complete project of one of my own tracks or remixes, with the full arrangement and, for my original tracks, the songwriting.',
  },
  {
    q: 'Can I use the project files in my own releases?',
    a: 'No. All project files are for educational purposes only: to study how the tracks are made and to learn techniques for your own original music. The projects, remakes and their parts may not be released, sold or shared.',
  },
  {
    q: 'Where can I download the project files?',
    a: 'All project files are sold and delivered through my Payhip store at payhip.com/ozee. Payhip handles the payment and the download.',
  },
  {
    q: 'Can I hear a remake before I buy the project file?',
    a: 'Yes. I post the drop remakes on my YouTube channel, so you can listen first and then decide.',
  },
  {
    q: 'Who are the project files for?',
    a: 'For producers who want to learn progressive house and EDM production in FL Studio from finished tracks: beginners who want to understand how a track is built, and experienced producers who want to compare sound selection, mixing and mastering decisions.',
  },
  {
    q: 'I have a question about a project file. How do I reach you?',
    a: 'Message me on Instagram or send me an email. Both are listed on the contact page.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'FL Studio Project Files & Free Progressive House FLPs by Ozee',
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    about: 'FL Studio project files: drop remakes of progressive house and big room tracks and original FLPs, for educational purposes',
    author: { '@type': 'Person', name: 'Ozee' },
    relatedLink: [PAYHIP_URL, YOUTUBE_URL],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'FL Studio project files by Ozee',
    itemListElement: projectFiles.map((file, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${file.artist} - ${file.title} (${file.kind}, FL Studio project file)`,
      url: file.url,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<Layout
  title="FL Studio Project Files & Free Progressive House FLPs"
  description="FL Studio project files by Ozee: free drop remakes and original progressive house & big room FLPs with samples, presets, mixing and mastering. On Payhip."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-16">
    <p class="reveal eyebrow mb-5">Free &amp; Original FLPs</p>
    <h1 class="reveal font-display text-5xl md:text-8xl mb-8">Project Files</h1>
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <p class="reveal max-w-2xl text-lg leading-relaxed text-paper/80">
        Open the complete FL Studio project behind a finished drop. I share drop remakes of
        well-known progressive house and big room tracks, and full FLPs of my own tracks and
        remixes. All drop remakes are free, and some of my original FLPs are free too. Every
        download is a ZIP with the full project, samples and presets, so you see the sound
        selection, mixing and mastering exactly as they were done.
      </p>
      <div class="reveal flex flex-wrap gap-x-7 gap-y-4 pl-1.5 lg:flex-col lg:items-stretch lg:pt-1">
        <a href={PAYHIP_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Shop on Payhip
        </a>
        <a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">
          Watch on YouTube
        </a>
      </div>
    </div>
  </section>

  <!-- Arrangement view (decorative) -->
  <section class="mx-auto max-w-6xl px-6 pb-24 md:pb-32" aria-hidden="true">
    <div class="reveal border border-line bg-ink-soft p-4 md:p-6">
      <div class="mb-3 flex items-center justify-between">
        <span class="meta text-paper/50">FL Studio project</span>
        <span class="meta text-brand">128 BPM</span>
      </div>
      <div class="grid grid-cols-[3.75rem_1fr] md:grid-cols-[6rem_1fr]">
        <div>
          <span class="block h-8 border-b border-line"></span>
          {
            lanes.map((lane) => (
              <span class="meta flex h-9 items-center border-b border-line text-paper/60 max-md:text-[0.6rem] max-md:tracking-[0.06em] md:h-11">
                {lane.name}
              </span>
            ))
          }
        </div>
        <div class="relative overflow-hidden">
          <div class="flex h-8 border-b border-line">
            {
              sections.map((section) => (
                <span
                  class="meta block truncate border-l border-line pl-1 leading-8 text-paper/45 max-md:text-[0.6rem] max-md:tracking-[0.04em] md:pl-2"
                  style={`width:${section.width}%`}
                >
                  {section.name}
                </span>
              ))
            }
          </div>
          {
            lanes.map((lane) => (
              <div class="relative h-9 border-b border-line md:h-11">
                {lane.clips.map(([start, length]) => (
                  <span
                    class:list={[
                      'absolute inset-y-1.5 border-l-2',
                      lane.accent ? 'border-brand bg-brand/80' : 'border-paper/60 bg-paper/15',
                    ]}
                    style={`left:${start}%;width:calc(${length}% - 3px)`}
                  />
                ))}
              </div>
            ))
          }
          <span class="playhead absolute inset-y-0 w-0.5 bg-brand"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Scroll cue: visible on arrival, hides once the visitor scrolls -->
  <div
    id="scroll-cue"
    class="scroll-cue pointer-events-none fixed inset-x-0 bottom-0 z-20 flex justify-center bg-gradient-to-t from-ink from-45% via-ink/90 to-transparent pt-24 pb-6"
  >
    <a
      href="#flps"
      aria-label="Scroll down to the project files"
      class="group pointer-events-auto flex flex-col items-center gap-2 text-paper/80 transition-colors hover:text-brand"
    >
      <span class="meta">Scroll to the FLPs</span>
      <span class="scroll-cue-box flex h-11 w-11 items-center justify-center border border-paper/40 bg-ink transition-colors group-hover:border-brand">
        <span class="arrow rotate-90 text-lg"></span>
      </span>
    </a>
  </div>

  <!-- Available project files -->
  <section id="flps" class="mx-auto max-w-6xl scroll-mt-24 px-6 pb-24 md:pb-32">
    <div class="reveal mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4">In the store</p>
        <h2 class="font-display text-3xl md:text-5xl">Available FLPs</h2>
        <p class="meta mt-4 text-paper/50">{projectFiles.length} project files &middot; newest first</p>
      </div>
      <a
        href={PAYHIP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group meta hidden shrink-0 items-center gap-2 whitespace-nowrap pb-2 text-paper/75 transition-colors hover:text-brand md:inline-flex"
      >
        View on Payhip <span class="arrow arrow-out"></span>
      </a>
    </div>
    <ul class="border-t border-line">
      {
        projectFiles.map((file) => (
          <li class="reveal border-b border-line">
            <a
              href={file.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group -mx-3 grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-2 px-3 py-5 transition-colors hover:bg-brand hover:text-ink md:grid-cols-[9rem_1fr_5rem_auto]"
            >
              <span class="meta col-span-2 text-brand group-hover:text-ink md:col-span-1">
                {file.kind}
              </span>
              <span class="min-w-0">
                <span class="block font-bold uppercase leading-tight [font-stretch:112%] md:text-xl">
                  {file.title}
                </span>
                <span class="meta mt-1.5 block opacity-60">
                  {file.artist}
                  {file.note && <> &middot; {file.note}</>}
                  {' '}&middot; FL Studio
                  {file.price && <span class="md:hidden"> &middot; {file.price}</span>}
                </span>
              </span>
              <span
                class:list={[
                  'meta hidden text-right md:block',
                  file.price === 'Free' && 'text-brand group-hover:text-ink',
                ]}
              >
                {file.price}
              </span>
              <span class="arrow arrow-out"></span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- What's in the ZIP -->
  <section class="mx-auto max-w-6xl px-6 pb-24 md:pb-32">
    <div class="grid gap-10 md:grid-cols-[4fr_7fr] md:gap-20">
      <div>
        <p class="reveal eyebrow mb-5">What's in the ZIP</p>
        <h2 class="reveal font-display text-3xl lg:text-5xl">
          Everything behind the finished track
        </h2>
      </div>
      <ol class="border-t border-line">
        {
          inside.map((item, i) => (
            <li class="reveal grid grid-cols-[2.5rem_1fr] gap-4 border-b border-line py-6">
              <span class="meta pt-1 text-brand">0{i + 1}</span>
              <div>
                <h3 class="mb-2 text-lg font-bold uppercase [font-stretch:112%]">{item.title}</h3>
                <p class="leading-relaxed text-paper/75">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Remakes & originals -->
  <section class="mx-auto max-w-6xl px-6 pb-24 md:pb-32">
    <p class="reveal eyebrow mb-5">Remakes &amp; originals</p>
    <h2 class="reveal font-display text-3xl md:text-5xl mb-10">Two kinds of FLPs</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {
        kinds.map((kind) => (
          <article class="reveal flex flex-col border border-line p-6 md:p-10">
            <p class="meta mb-6 self-start bg-brand px-3 py-1.5 text-ink">{kind.label}</p>
            <h3 class="mb-4 font-display text-2xl md:text-3xl">{kind.title}</h3>
            <p class="mb-8 leading-relaxed text-paper/75">{kind.text}</p>
            <ul class="mt-auto flex flex-wrap gap-2">
              {kind.covers.map((item) => (
                <li class="meta border border-line px-3 py-1.5 text-paper/70">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-line">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <p class="reveal eyebrow mb-5">How it works</p>
      <h2 class="reveal font-display text-3xl md:text-5xl mb-12">Listen. Download. Learn.</h2>
      <ol class="grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((step, i) => (
            <li class="reveal">
              <p class="font-display text-outline text-7xl mb-4">0{i + 1}</p>
              <h3 class="mb-3 text-xl font-bold uppercase [font-stretch:112%]">{step.title}</h3>
              <p class="leading-relaxed text-paper/75">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why remakes -->
  <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="grid gap-10 md:grid-cols-[4fr_7fr] md:gap-20">
      <div>
        <p class="reveal eyebrow mb-5">Why project files</p>
        <h2 class="reveal font-display text-3xl md:text-5xl">Learn from a finished track</h2>
      </div>
      <div class="reveal space-y-6 text-lg leading-relaxed text-paper/80">
        <p>
          Tutorials usually show one technique at a time. A complete FL Studio project shows how all
          of them work together in a finished drop: how the kick and bass share the low end, how
          the leads and chords are layered and why the drop hits as hard as it does. The original
          FLPs go further and show the whole track, from the breakdown and build-up to the
          arrangement and songwriting.
        </p>
        <p>
          I&rsquo;ve been producing melodic progressive house since 2018, with releases on labels
          like Revealed Recordings, Generation Smash and Stardust Records. The project files are
          where I share that workflow with other producers who want to learn EDM production from
          real tracks.
        </p>
        <p>
          <a href="/releases/" class="link">Listen to my own releases</a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-6xl px-6 pb-24 md:pb-32">
    <div class="grid gap-10 md:grid-cols-[4fr_7fr] md:gap-20">
      <div>
        <p class="reveal eyebrow mb-5">FAQ</p>
        <h2 class="reveal font-display text-3xl md:text-5xl">Questions</h2>
      </div>
      <div class="border-t border-line">
        {
          faqs.map((faq) => (
            <details class="faq reveal group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold uppercase [font-stretch:112%] transition-colors hover:text-brand">
                {faq.q}
                <span class="faq-icon relative h-4 w-4 shrink-0" aria-hidden="true" />
              </summary>
              <p class="pb-6 pr-10 leading-relaxed text-paper/75">
                {faq.q.startsWith('I have a question') ? (
                  <>
                    Message me on Instagram or send me an email. Both are listed on the{' '}
                    <a href="/contact/" class="link">contact page</a>.
                  </>
                ) : (
                  faq.a
                )}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-8">
    <a
      href={PAYHIP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="reveal group flex flex-col gap-6 bg-brand p-8 text-ink md:flex-row md:items-center md:justify-between md:p-14"
    >
      <span>
        <span class="meta mb-3 block opacity-70">payhip.com/ozee</span>
        <span class="block font-display text-3xl md:text-6xl">Browse all project files</span>
        <span class="meta mt-4 block opacity-70">For educational purposes only</span>
      </span>
      <span class="arrow arrow-out text-4xl md:text-6xl"></span>
    </a>
  </section>
</Layout>

<style>
  .playhead {
    animation: playhead 12s linear infinite;
  }

  @keyframes playhead {
    from {
      left: 0%;
    }
    to {
      left: 100%;
    }
  }

  .scroll-cue {
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0s;
  }

  .scroll-cue[data-hidden] {
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }

  .scroll-cue-box {
    animation: scroll-cue-bounce 1.6s ease-in-out infinite;
  }

  @keyframes scroll-cue-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform 0.25s ease;
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Shown only on arrival and only while the product list is still below the fold.
  const cue = document.getElementById('scroll-cue');
  const list = document.getElementById('flps');
  const updateCue = () => {
    const listVisible = (list?.getBoundingClientRect().top ?? 0) < window.innerHeight;
    cue?.toggleAttribute('data-hidden', window.scrollY > 80 || listVisible);
  };
  updateCue();
  window.addEventListener('scroll', updateCue, { passive: true });
  window.addEventListener('resize', updateCue);
</script>
