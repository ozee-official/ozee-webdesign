---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { SPOTIFY_URL } from '../../data/socials';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases.map((release) => ({
    params: { slug: release.data.slug },
    props: { release, allReleases: releases },
  }));
}

const { release, allReleases } = Astro.props;
const { title, year, label, with: collaborator, description, cover, coverAlt, spotifyUrl } =
  release.data;

const trackSpotifyUrl = spotifyUrl ?? SPOTIFY_URL;

const more = allReleases
  .filter((r) => r.data.slug !== release.data.slug)
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicRecording',
  name: title,
  datePublished: String(year),
  byArtist: {
    '@type': 'MusicGroup',
    name: 'Ozee',
  },
  ...(collaborator ? { contributor: { '@type': 'Person', name: collaborator } } : {}),
  inAlbum: {
    '@type': 'MusicRelease',
    recordLabel: {
      '@type': 'Organization',
      name: label,
    },
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  ...(spotifyUrl ? { sameAs: [spotifyUrl] } : {}),
};
---

<Layout
  title={title}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  type="music.song"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-24 md:pt-40">
    <a
      id="back-link"
      href="/releases/"
      class="reveal group meta mb-10 inline-flex items-center gap-3 text-paper/60 transition-colors hover:text-brand"
    >
      <span class="arrow rotate-180"></span>
      <span id="back-label">All releases</span>
    </a>
    <div class="grid items-center gap-12 md:grid-cols-[5fr_6fr] md:gap-20">
      <div class="reveal relative mr-4 mb-4 md:mr-5 md:mb-5">
        <span class="absolute inset-0 translate-x-4 translate-y-4 bg-brand md:translate-x-5 md:translate-y-5"></span>
        <img
          src={cover}
          alt={coverAlt}
          width="1000"
          height="1000"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-square w-full object-cover"
        />
      </div>
      <div>
        <p class="reveal eyebrow mb-5">Release {String(release.data.order).padStart(2, '0')}</p>
        <h1 class="reveal font-display text-3xl sm:text-4xl md:text-6xl mb-8 text-balance">
          {title}
        </h1>
        <dl class="reveal mb-8 border-t border-line">
          <div class="flex justify-between gap-6 border-b border-line py-3">
            <dt class="meta text-paper/50">Label</dt>
            <dd class="meta text-right">{label}</dd>
          </div>
          {
            collaborator && (
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="meta text-paper/50">With</dt>
                <dd class="meta text-right">{collaborator}</dd>
              </div>
            )
          }
          <div class="flex justify-between gap-6 border-b border-line py-3">
            <dt class="meta text-paper/50">Year</dt>
            <dd class="meta text-right">{year}</dd>
          </div>
        </dl>
        <p class="reveal mb-10 text-lg leading-relaxed text-paper/80">{description}</p>
        <a
          href={trackSpotifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal btn-primary ml-1.5"
        >
          Listen on Spotify
        </a>
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 pb-12">
        <div class="reveal mb-8 flex items-end justify-between gap-6 border-b border-line pb-4">
          <h2 class="font-display text-2xl md:text-4xl">More Releases</h2>
          <a href="/releases/" class="group meta inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-paper/75 transition-colors hover:text-brand">
            View all <span class="arrow"></span>
          </a>
        </div>
        <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {more.map((r) => (
            <ReleaseCard release={r} />
          ))}
        </div>
      </section>
    )
  }
</Layout>

<script>
  // Arriving from the homepage, the back link returns there (and to the same scroll position).
  const link = document.getElementById('back-link');
  const label = document.getElementById('back-label');
  const referrer = document.referrer ? new URL(document.referrer) : null;

  if (link && label && referrer?.origin === location.origin && referrer.pathname === '/') {
    label.textContent = 'Back to home';
    link.setAttribute('href', '/#discography');
    link.addEventListener('click', (event) => {
      if (history.length > 1) {
        event.preventDefault();
        history.back();
      }
    });
  }
</script>
