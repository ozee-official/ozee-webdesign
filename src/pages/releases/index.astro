---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';

const releases = (await getCollection('releases')).sort((a, b) => b.data.order - a.data.order);
const years = [...new Set(releases.map((release) => release.data.year))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ozee — Discography',
  itemListElement: releases.map((release, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/releases/${release.data.slug}/`, Astro.site).toString(),
    name: release.data.title,
  })),
};
---

<Layout
  title="Releases"
  description="Browse the full discography of Ozee, a German progressive house and festival EDM producer, including Hope (Places A Journey), Embrace The Night, I'm Broken, Morgen Untergehen and Reminds Me Of You."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-12 md:pt-40">
    <p class="reveal eyebrow mb-5">Discography</p>
    <h1 class="reveal font-display text-5xl md:text-8xl mb-8">Releases</h1>
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <p class="reveal max-w-2xl text-lg leading-relaxed text-paper/75">
        From my first breakthrough in the progressive house community to my latest release on
        Generation Smash, every track I create reflects my journey as an Artist. Explore all of my
        Releases here.
      </p>
      <nav aria-label="Jump to year" class="reveal">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            years.map((year) => (
              <li>
                <a href={`#y${year}`} class="meta text-paper/60 transition-colors hover:text-brand">
                  {year}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    years.map((year, yearIndex) => {
      const inYear = releases.filter((release) => release.data.year === year);
      return (
        <section id={`y${year}`} class="mx-auto max-w-6xl scroll-mt-24 px-6 pb-20">
          <div class="reveal mb-8 flex items-baseline justify-between border-b border-line pb-4">
            <h2 class="font-display text-3xl md:text-5xl">{year}</h2>
            <p class="meta text-paper/50">
              {inYear.length} {inYear.length === 1 ? 'release' : 'releases'}
            </p>
          </div>
          <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {inYear.map((release, i) => (
              <ReleaseCard release={release} priority={yearIndex === 0 && i < 3} />
            ))}
          </div>
        </section>
      );
    })
  }
</Layout>
