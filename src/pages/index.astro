---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SPOTIFY_URL } from '../data/socials';
import { labelLinks } from '../data/labels';

const releases = (await getCollection('releases')).sort((a, b) => b.data.order - a.data.order);
const latest = releases[0];
const recent = releases.slice(1, 7);
const labels = [...new Set(releases.map((release) => release.data.label))].filter(
  (label) => !['Official Remix', 'Self-Release'].includes(label)
);
const tickerItems = latest
  ? ['Out now', latest.data.title, latest.data.label, 'Listen now']
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Ozee',
  genre: ['Progressive House', 'Festival EDM'],
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  sameAs: [SPOTIFY_URL],
  description:
    'Ozee is an electronic music producer from Germany creating progressive house and festival EDM, with releases on labels including Interplay Records, Stardust Records, FeelQ Recordings and more.',
};
---

<Layout
  title="Official Website"
  description="Official website of Ozee, a German progressive house and EDM producer. Discover his music and latest releases."
  image="/images/og-default.jpeg"
  type="website"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative flex flex-col overflow-hidden md:min-h-[100svh] md:flex-row md:items-end">
    <div class="hero-photo h-[64svh] md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[58%]">
      <img
        src="/images/press/hero-portrait.jpg"
        alt="Portrait of Ozee, progressive house and festival EDM producer from Germany"
        width="1024"
        height="1076"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover object-top"
      />
    </div>

    <div class="relative mx-auto -mt-24 w-full max-w-6xl px-6 pb-14 md:mt-0 md:pt-40 md:pb-20">
      <h1 class="reveal font-display text-[clamp(5rem,21vw,15rem)] leading-[0.8] -ml-[0.04em]">
        OZEE
      </h1>
      <div class="mt-8 flex flex-col gap-8 md:mt-12 md:flex-row md:items-end md:justify-between">
        <p class="reveal max-w-md text-lg text-paper/80 text-balance">
          I&rsquo;m a German music producer crafting melodic progressive house music. Since 2018,
          I&rsquo;ve been shaping my sound with emotional melodies, powerful energy, and a passion
          for creating unforgettable moments through music.
        </p>
        <div class="reveal flex flex-wrap gap-x-7 gap-y-4 pl-1.5">
          <a href={SPOTIFY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Listen on Spotify
          </a>
          <a href="/releases/" class="btn-outline">Explore Releases</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Out-now ticker -->
  {
    latest && (
      <a
        href={`/releases/${latest.data.slug}/`}
        aria-label={`Out now: ${latest.data.title} on ${latest.data.label}`}
        class="ticker block overflow-hidden bg-brand py-4 text-ink"
      >
        <div class="ticker-track flex w-max animate-marquee">
          {[0, 1].map((copy) => (
            <div class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
              {[0, 1, 2].map(() =>
                tickerItems.map((item) => (
                  <>
                    <span class="px-6 text-lg font-extrabold uppercase [font-stretch:125%]">{item}</span>
                    <span class="h-4 w-6 -skew-x-[28deg] bg-[repeating-linear-gradient(to_right,#000_0_4px,transparent_4px_8px)]" />
                  </>
                ))
              )}
            </div>
          ))}
        </div>
      </a>
    )
  }

  <!-- Latest release spotlight -->
  {
    latest && (
      <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <div class="grid items-center gap-12 md:grid-cols-[5fr_6fr] md:gap-20">
          <a
            href={`/releases/${latest.data.slug}/`}
            class="reveal group relative block mr-4 mb-4 md:mr-5 md:mb-5"
          >
            <span class="absolute inset-0 translate-x-4 translate-y-4 bg-brand transition-transform duration-300 group-hover:translate-x-6 group-hover:translate-y-6 md:translate-x-5 md:translate-y-5 md:group-hover:translate-x-7 md:group-hover:translate-y-7" />
            <img
              src={latest.data.cover}
              alt={latest.data.coverAlt}
              width="1000"
              height="1000"
              loading="lazy"
              class="relative aspect-square w-full object-cover transition-transform duration-300 group-hover:-translate-x-2 group-hover:-translate-y-2"
            />
          </a>
          <div>
            <p class="reveal eyebrow mb-5">Latest Release</p>
            <h2 class="reveal font-display text-4xl md:text-6xl mb-8">{latest.data.title}</h2>
            <dl class="reveal mb-8 border-t border-line">
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="meta text-paper/50">Label</dt>
                <dd class="meta text-right">{latest.data.label}</dd>
              </div>
              {latest.data.with && (
                <div class="flex justify-between gap-6 border-b border-line py-3">
                  <dt class="meta text-paper/50">With</dt>
                  <dd class="meta text-right">{latest.data.with}</dd>
                </div>
              )}
              <div class="flex justify-between gap-6 border-b border-line py-3">
                <dt class="meta text-paper/50">Year</dt>
                <dd class="meta text-right">{latest.data.year}</dd>
              </div>
            </dl>
            <p class="reveal mb-10 text-lg leading-relaxed text-paper/80">{latest.data.tagline}</p>
            <div class="reveal flex flex-wrap gap-x-7 gap-y-4 pl-1.5">
              {latest.data.spotifyUrl && (
                <a
                  href={latest.data.spotifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary"
                >
                  Listen now
                </a>
              )}
              <a href={`/releases/${latest.data.slug}/`} class="btn-outline">
                View Release
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Recent releases -->
  <section id="discography" class="mx-auto max-w-6xl scroll-mt-24 px-6 pb-24 md:pb-32">
    <div class="reveal mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4">Discography</p>
        <h2 class="font-display text-4xl md:text-6xl">All Releases</h2>
      </div>
      <a href="/releases/" class="group meta hidden items-center gap-2 pb-2 text-paper/75 transition-colors hover:text-brand md:inline-flex">
        View all {releases.length} <span class="arrow"></span>
      </a>
    </div>
    <ul class="border-t border-line">
      {
        recent.map((release) => (
          <li class="reveal border-b border-line">
            <a
              href={`/releases/${release.data.slug}/`}
              class="group -mx-3 grid grid-cols-[3.5rem_1fr_auto] items-center gap-4 px-3 py-3 transition-colors hover:bg-brand hover:text-ink md:grid-cols-[2.5rem_4.5rem_1fr_13rem_3.5rem_1.5rem] md:gap-6"
            >
              <span class="meta hidden opacity-50 md:block">
                {String(release.data.order).padStart(2, '0')}
              </span>
              <img
                src={release.data.cover}
                alt={release.data.coverAlt}
                width="144"
                height="144"
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover"
              />
              <span class="min-w-0">
                <span class="block font-bold uppercase leading-tight [font-stretch:112%] md:text-xl">
                  {release.data.title}
                </span>
                <span class="meta mt-1.5 block opacity-60">
                  <span class="md:hidden">
                    {release.data.label} &middot; {release.data.year}
                  </span>
                  {release.data.with && (
                    <span class="hidden md:inline">with {release.data.with}</span>
                  )}
                </span>
              </span>
              <span class="meta hidden opacity-60 md:block">{release.data.label}</span>
              <span class="meta hidden opacity-60 md:block">{release.data.year}</span>
              <span class="arrow"></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-10 pl-1.5 md:hidden">
      <a href="/releases/" class="btn-outline">View all releases</a>
    </div>
  </section>

  <!-- Labels -->
  <section class="hidden border-y border-line md:block">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <p class="reveal eyebrow mb-8">Released on</p>
      <ul class="reveal flex flex-wrap gap-x-6 gap-y-3">
        {
          labels.map((label) => (
            <li class="font-display text-3xl text-paper/45 transition-colors hover:text-paper">
              {labelLinks[label] ? (
                <a
                  href={labelLinks[label]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-brand"
                >
                  {label}
                </a>
              ) : (
                label
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Bio teaser -->
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-8 md:pt-32">
    <div class="grid items-center gap-14 md:grid-cols-[4fr_7fr] md:gap-20">
      <div class="reveal ticks mx-2 md:mx-0">
        <img
          src="/images/press/press-photo-1.jpeg"
          alt="Ozee, German progressive house producer, outdoors in a white hoodie"
          width="1204"
          height="1600"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div>
        <p class="reveal eyebrow mb-6">About Ozee</p>
        <h2 class="reveal font-display text-3xl md:text-5xl mb-8">
          Powerful, emotional, festival-ready.
        </h2>
        <p class="reveal mb-10 max-w-xl text-lg leading-relaxed text-paper/80">
          What started as pure curiosity in 2018 grew into a passion for crafting music that
          blends influences from various dance music genres: powerful, emotional and yet
          festival-ready.
        </p>
        <a href="/about/" class="reveal btn-outline ml-1.5">Read my full story</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-photo {
    -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 40%);
    mask-image: linear-gradient(to top, transparent 0%, #000 40%);
  }

  @media (min-width: 768px) {
    .hero-photo {
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, #000 40%),
        linear-gradient(to top, transparent 0%, #000 28%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0%, #000 40%),
        linear-gradient(to top, transparent 0%, #000 28%);
      mask-composite: intersect;
    }
  }

  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }
</style>
