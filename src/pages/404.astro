---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page could not be found." noIndex={true}>
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 pt-20">
    <p class="text-sm uppercase tracking-[0.3em] text-white/50 mb-4">404</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">Page Not Found</h1>
    <p class="text-white/70 mb-10 max-w-md">
      The page you're looking for doesn't exist. Head back home or check out the latest releases.
    </p>
    <div class="flex gap-4">
      <a
        href="/"
        class="btn-primary"
      >
        Back Home
      </a>
      <a
        href="/releases/"
        class="btn-outline"
      >
        Releases
      </a>
    </div>
  </section>
</Layout>
