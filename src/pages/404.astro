---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page could not be found." noIndex={true}>
  <section class="mx-auto flex min-h-[80vh] max-w-6xl flex-col justify-center px-6 pt-28">
    <p class="font-display text-outline text-[clamp(7rem,28vw,20rem)] leading-[0.8]" aria-hidden="true">
      404
    </p>
    <h1 class="font-display text-3xl md:text-5xl mt-8 mb-5">Page Not Found</h1>
    <p class="mb-10 max-w-md text-lg text-paper/75">
      The page you're looking for doesn't exist. Head back home or check out the latest releases.
    </p>
    <div class="flex flex-wrap gap-x-7 gap-y-4 pl-1.5">
      <a href="/" class="btn-primary">Back Home</a>
      <a href="/releases/" class="btn-outline">Releases</a>
    </div>
  </section>
</Layout>
