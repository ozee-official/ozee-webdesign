---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Legal Notice"
  description="Legal notice for Ozee, pursuant to Section 5 of the German Digital Services Act (DDG)."
>
  <section class="relative overflow-hidden pt-24 pb-24 min-h-[70vh] md:pt-40">
    <div class="mx-auto max-w-3xl px-6">
      <p class="reveal eyebrow mb-5">Legal</p>
      <h1 class="reveal font-display text-4xl md:text-6xl mb-10">Legal Notice</h1>

      <div class="reveal text-white/70 leading-relaxed space-y-6">
        <div>
          <h2 class="mb-3 text-lg font-bold uppercase text-paper [font-stretch:112%]">
            Information pursuant to Section 5 of the German Digital Services Act (DDG)
          </h2>
          <p>
            Adrian Stapper<br />
            Denniweg 1<br />
            77830 Bühlertal<br />
            Germany
          </p>
        </div>

        <div>
          <h2 class="mb-3 text-lg font-bold uppercase text-paper [font-stretch:112%]">Contact</h2>
          <p>
            Email: <a href="mailto:ozeemusic.contact@gmail.com" class="link">ozeemusic.contact@gmail.com</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
