---
import Layout from '../layouts/Layout.astro';

const SPOTIFY_URL =
  'https://open.spotify.com/intl-de/artist/4HCreTyqXNdNXZKMYr4qCX?si=k1KQCrOnQiCeBKHsIFPFkA';
const CONTACT_EMAIL = 'ozeemusic.contact@gmail.com';
---

<Layout
  title="Contact"
  description="Get in touch with Ozee for collaborations, remixes and press inquiries."
>
  <section class="relative overflow-hidden pt-40 pb-24 min-h-[70vh] flex items-center">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <p class="reveal text-sm uppercase tracking-[0.3em] text-brand-soft/80 mb-4">Get In Touch</p>
      <h1 class="reveal text-4xl md:text-5xl font-bold mb-6">Contact</h1>
      <p class="reveal text-white/70 leading-relaxed mb-10">
        For collaborations, remixes or press inquiries, reach out directly by email or connect on
        Spotify.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="btn-primary"
        >
          {CONTACT_EMAIL}
        </a>
        <a
          href={SPOTIFY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          Follow on Spotify
        </a>
      </div>
    </div>
  </section>
</Layout>
