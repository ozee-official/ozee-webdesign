---
import Layout from '../layouts/Layout.astro';

const SPOTIFY_URL =
  'https://open.spotify.com/intl-de/artist/4HCreTyqXNdNXZKMYr4qCX?si=k1KQCrOnQiCeBKHsIFPFkA';
const CONTACT_EMAIL = 'ozeemusic.contact@gmail.com';
---

<Layout
  title="Contact & Booking"
  description="Get in touch with Ozee for booking, collaborations, remixes and press inquiries."
>
  <section class="relative overflow-hidden pt-40 pb-24 min-h-[70vh] flex items-center">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(50% 40% at 50% 20%, rgba(255,138,61,0.16), transparent 70%);"
    >
    </div>
    <div class="mx-auto max-w-2xl px-6 text-center">
      <p class="reveal text-sm uppercase tracking-[0.3em] text-white/50 mb-4">Get In Touch</p>
      <h1 class="reveal text-4xl md:text-5xl font-bold mb-6">Contact &amp; Booking</h1>
      <p class="reveal text-white/70 leading-relaxed mb-10">
        For booking requests, collaborations, remixes or press inquiries, reach out directly by
        email or connect on Spotify.
      </p>
      <div class="reveal flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="inline-flex items-center justify-center rounded-full bg-white text-ink font-semibold px-6 py-3 transition-transform hover:scale-105"
        >
          {CONTACT_EMAIL}
        </a>
        <a
          href={SPOTIFY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full border border-white/25 text-white font-semibold px-6 py-3 transition-colors hover:bg-white/10"
        >
          Follow on Spotify
        </a>
      </div>
    </div>
  </section>
</Layout>
