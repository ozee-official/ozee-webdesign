---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum"
  description="Impressum von Ozee gemäß § 5 DDG."
>
  <section class="relative overflow-hidden pt-40 pb-24 min-h-[70vh]">
    <div class="mx-auto max-w-2xl px-6">
      <p class="reveal text-sm uppercase tracking-[0.3em] text-brand-soft/80 mb-4">Legal</p>
      <h1 class="reveal text-4xl md:text-5xl font-bold mb-10">Impressum</h1>

      <div class="reveal text-white/70 leading-relaxed space-y-6">
        <div>
          <h2 class="text-white/90 font-semibold mb-2">Angaben gemäß § 5 DDG</h2>
          <p>
            Adrian Stapper<br />
            Denniweg 1<br />
            77830 Bühlertal<br />
            Deutschland
          </p>
        </div>

        <div>
          <h2 class="text-white/90 font-semibold mb-2">Kontakt</h2>
          <p>
            E-Mail: <a href="mailto:ozeemusic.contact@gmail.com" class="hover:text-brand-soft transition-colors">ozeemusic.contact@gmail.com</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
