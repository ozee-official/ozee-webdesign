---
import SocialIcons from './SocialIcons.astro';
import { SPOTIFY_URL } from '../data/socials';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/releases/', label: 'Releases' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="fixed top-0 inset-x-0 z-40 border-b border-line bg-ink/85 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center shrink-0" aria-label="Ozee — Home">
      <img src="/images/logo.png" alt="Ozee logo" width="1600" height="448" class="h-6 w-auto" />
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-9">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-link meta relative py-2 transition-colors hover:text-brand',
              isActive(item.href) ? 'text-brand' : 'text-paper/75',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={SPOTIFY_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary hidden md:inline-flex px-5 py-3 text-xs"
    >
      Listen on Spotify
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="md:hidden relative h-10 w-10 -mr-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <span class="menu-bar absolute left-2 right-2 top-[15px] h-0.5 bg-paper transition-transform duration-300"></span>
      <span class="menu-bar absolute left-2 right-2 top-[23px] h-0.5 bg-paper transition-transform duration-300"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="md:hidden hidden h-[calc(100dvh-4rem)] flex-col justify-between overflow-y-auto border-t border-line bg-ink px-6 pt-6 pb-10"
  >
    <ul>
      {
        navItems.map((item, i) => (
          <li class="border-b border-line">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-baseline gap-4 py-5 font-display text-4xl',
                isActive(item.href) ? 'text-brand' : 'text-paper',
              ]}
            >
              <span class="meta text-paper/50">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-col items-start gap-6 pt-8">
      <a href={SPOTIFY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary ml-1.5">
        Listen on Spotify
      </a>
      <SocialIcons class="gap-4" size="h-6 w-6" />
    </div>
  </nav>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0) skewX(-28deg);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1) skewX(-28deg);
  }

  #menu-toggle[aria-expanded='true'] .menu-bar:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  #menu-toggle[aria-expanded='true'] .menu-bar:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    document.documentElement.classList.toggle('overflow-hidden', Boolean(isOpen));
  });
</script>
