---
import type { CollectionEntry } from 'astro:content';

interface Props {
  release: CollectionEntry<'releases'>;
  priority?: boolean;
}

const { release, priority = false } = Astro.props;
const { title, year, label, cover, coverAlt, with: collaborator } = release.data;
---

<a
  href={`/releases/${release.data.slug}/`}
  class="group reveal relative block aspect-square overflow-hidden rounded-2xl border border-white/10 transition-transform duration-300 hover:-translate-y-1 hover:border-white/25"
>
  <!-- Cover art as full tile background -->
  <img
    src={cover}
    alt={coverAlt}
    width="1000"
    height="1000"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
  />

  <!-- Gradient overlay for text legibility -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-black/10 transition-opacity duration-300 group-hover:from-black/95"
  >
  </div>

  <div class="absolute inset-x-0 bottom-0 p-5">
    <h3 class="text-lg font-semibold text-white mb-1 text-balance">{title}</h3>
    <p class="text-sm text-white/70">
      {label} &middot; {year}{collaborator ? ` · with ${collaborator}` : ''}
    </p>
  </div>
</a>
