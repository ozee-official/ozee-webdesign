---
import type { CollectionEntry } from 'astro:content';

interface Props {
  release: CollectionEntry<'releases'>;
  priority?: boolean;
}

const { release, priority = false } = Astro.props;
const { title, year, label, cover, coverAlt, accent, type, with: collaborator } = release.data;

const typeLabel =
  type === 'remix' ? 'Official Remix' : type === 'collaboration' ? 'Collaboration' : 'Original';
---

<a
  href={`/releases/${release.data.slug}/`}
  class="group reveal block rounded-2xl border border-white/10 bg-white/[0.02] overflow-hidden transition-transform duration-300 hover:-translate-y-1 hover:border-white/25"
>
  <div class="aspect-square overflow-hidden relative">
    <img
      src={cover}
      alt={coverAlt}
      width="1000"
      height="1000"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span
      class="absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-semibold backdrop-blur-md"
      style={`background:${accent}33; color:#fff; border:1px solid ${accent}66;`}
    >
      {typeLabel}
    </span>
  </div>
  <div class="p-5">
    <h3 class="text-lg font-semibold text-white mb-1">{title}</h3>
    <p class="text-sm text-white/50">
      {label} &middot; {year}{collaborator ? ` · with ${collaborator}` : ''}
    </p>
  </div>
</a>
