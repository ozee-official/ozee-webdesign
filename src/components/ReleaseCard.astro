---
import type { CollectionEntry } from 'astro:content';

interface Props {
  release: CollectionEntry<'releases'>;
  priority?: boolean;
}

const { release, priority = false } = Astro.props;
const { title, year, label, cover, coverAlt, with: collaborator } = release.data;
---

<a href={`/releases/${release.data.slug}/`} class="group reveal block">
  <div class="relative aspect-square overflow-hidden bg-ink-soft">
    <img
      src={cover}
      alt={coverAlt}
      width="1000"
      height="1000"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span
      class="meta absolute bottom-0 left-0 flex items-center gap-2 bg-brand px-4 py-3 text-ink translate-y-full transition-transform duration-300 group-hover:translate-y-0 group-focus-visible:translate-y-0"
    >
      View release <span class="arrow"></span>
    </span>
  </div>
  <div class="flex items-baseline justify-between gap-4 border-b border-line pt-4 pb-3 transition-colors group-hover:border-brand">
    <h3 class="font-bold uppercase leading-tight [font-stretch:112%] transition-colors group-hover:text-brand">
      {title}
    </h3>
    <span class="meta shrink-0 text-paper/50">{year}</span>
  </div>
  <p class="meta pt-2.5 text-paper/50">
    {label}{collaborator ? ` · with ${collaborator}` : ''}
  </p>
</a>
