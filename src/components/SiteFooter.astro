---
const SPOTIFY_URL =
  'https://open.spotify.com/intl-de/artist/4HCreTyqXNdNXZKMYr4qCX?si=k1KQCrOnQiCeBKHsIFPFkA';
const INSTAGRAM_URL = 'https://www.instagram.com/_ozeemusic_/';
const SOUNDCLOUD_URL = 'https://soundcloud.com/ozeemusic';
const YOUTUBE_URL = 'https://www.youtube.com/@ozeemusic7198';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 mt-24">
  <div class="mx-auto max-w-6xl px-6 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <img src="/images/logo.png" alt="Ozee logo" width="1600" height="448" class="h-6 w-auto mb-4" />
      <p class="text-white/60 text-sm max-w-xs">
        Electronic Music Producer from Germany, creating melodic, high-energy dance music since
        2018.
      </p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <h2 class="text-white/40 uppercase tracking-widest text-xs mb-4">Explore</h2>
      <ul class="space-y-2 text-white/70">
        <li><a href="/" class="hover:text-brand-soft transition-colors">Home</a></li>
        <li><a href="/releases/" class="hover:text-brand-soft transition-colors">Releases</a></li>
        <li><a href="/about/" class="hover:text-brand-soft transition-colors">About</a></li>
        <li><a href="/contact/" class="hover:text-brand-soft transition-colors">Contact</a></li>
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="text-white/40 uppercase tracking-widest text-xs mb-4">Connect</h2>
      <ul class="space-y-2 text-white/70">
        <li>
          <a
            href={SPOTIFY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-soft transition-colors"
          >
            Spotify
          </a>
        </li>
        <li>
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-soft transition-colors"
          >
            Instagram
          </a>
        </li>
        <li>
          <a
            href={SOUNDCLOUD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-soft transition-colors"
          >
            SoundCloud
          </a>
        </li>
        <li>
          <a
            href={YOUTUBE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-soft transition-colors"
          >
            YouTube
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-6 py-6 text-xs text-white/40">
      &copy; {year} Ozee. All rights reserved.
    </p>
  </div>
</footer>
